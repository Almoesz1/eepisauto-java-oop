<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<StackPane stylesheets="@../styles/main.css" prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eepisauto.PrimaryController">
    
    <BorderPane fx:id="mainAppPane" opacity="0">
        <!-- SIDEBAR (SEKARANG 7 MENU VIP) -->
        <left>
            <VBox prefWidth="270.0" spacing="5.0" styleClass="sidebar">
                <padding><Insets top="30" left="0" right="0" bottom="20"/></padding>
                <Label text="EEPIS MOTORS" styleClass="text-title" alignment="CENTER" prefWidth="270.0">
                    <VBox.margin><Insets bottom="30"/></VBox.margin>
                </Label>
                
                <Button fx:id="btnNavShowroom" text="🏎️  Katalog Showroom" prefWidth="270.0" styleClass="nav-btn, active" onAction="#navToShowroom"/>
                <Button fx:id="btnNavGarasi" text="🛡️  Dasbor Garasi" prefWidth="270.0" styleClass="nav-btn" onAction="#navToGarasi"/>
                <Button fx:id="btnNavServis" text="🔧  Servis Center" prefWidth="270.0" styleClass="nav-btn" onAction="#navToServis"/>
                <Button fx:id="btnNavPajak" text="⚖️  Pajak &amp; Asuransi" prefWidth="270.0" styleClass="nav-btn" onAction="#navToPajak"/>
                <Button fx:id="btnNavTradeIn" text="🤝  Trade-In (Jual)" prefWidth="270.0" styleClass="nav-btn" onAction="#navToTradeIn"/>
                <Button fx:id="btnNavRiwayat" text="🧾  Log Transaksi" prefWidth="270.0" styleClass="nav-btn" onAction="#navToRiwayat"/>
                <Button fx:id="btnNavRewards" text="🎁  VIP Lounge" prefWidth="270.0" styleClass="nav-btn" onAction="#navToRewards"/>
                
                <Region VBox.vgrow="ALWAYS" />
                <VBox style="-fx-padding: 25; -fx-background-color: #111827; -fx-border-color: #1e293b transparent transparent transparent;" spacing="8">
                    <Label fx:id="lblSidebarUser" text="Nama Klien" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label fx:id="lblSidebarTier" text="Tier VIP" styleClass="text-gold"/>
                    <Label fx:id="lblSidebarSaldo" text="Rp 0" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
            </VBox>
        </left>

        <center>
            <StackPane style="-fx-padding: 30;">
                
                <!-- PAGE 1: SHOWROOM -->
                <VBox fx:id="pageShowroom" spacing="20.0">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Katalog Eksklusif" styleClass="text-title"/>
                            <Label text="Implementasi Polimorfisme &amp; Interface OOP." styleClass="text-subtitle"/>
                        </VBox>
                        <TextField fx:id="txtSearch" promptText="🔍 Cari Model..." prefWidth="280"/>
                        <ComboBox fx:id="comboFilter" prefWidth="200"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                        <FlowPane fx:id="showroomContainer" hgap="30" vgap="30">
                            <padding><Insets top="10" bottom="20" left="5" right="5"/></padding>
                        </FlowPane>
                    </ScrollPane>
                </VBox>

                <!-- PAGE 2: GARASI & BAR CHART -->
                <VBox fx:id="pageGarasi" spacing="20.0" visible="false" opacity="0">
                    <HBox spacing="20">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Dasbor Aset Garasi" styleClass="text-title"/>
                            <Label text="Visualisasi portofolio aset kendaraan VVIP Anda." styleClass="text-subtitle"/>
                        </VBox>
                        <VBox styleClass="dashboard-box" alignment="CENTER_RIGHT" minWidth="250">
                            <Label text="Total Nilai Aset" styleClass="text-subtitle"/>
                            <Label fx:id="lblTotalAset" text="Rp 0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="scroll-pane">
                            <FlowPane fx:id="garasiContainer" hgap="25" vgap="25">
                                <padding><Insets top="5" bottom="10" left="5" right="5"/></padding>
                            </FlowPane>
                        </ScrollPane>
                        <VBox prefWidth="450" styleClass="dashboard-box">
                            <Label text="Grafik Nilai Aset (Rp)" styleClass="text-accent" style="-fx-font-size: 16px;"/>
                            <BarChart fx:id="chartAset" VBox.vgrow="ALWAYS" legendVisible="false">
                                <xAxis><CategoryAxis label="Model" fx:id="xAxis"/></xAxis>
                                <yAxis><NumberAxis fx:id="yAxis"/></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- PAGE 3: SERVIS -->
                <VBox fx:id="pageServis" spacing="25.0" visible="false" opacity="0">
                    <Label text="Pusat Servis Berkala" styleClass="text-title"/>
                    <Label text="OOP Encapsulation: Memotong saldo rekening secara aman." styleClass="text-subtitle"/>
                    <HBox spacing="30" VBox.vgrow="ALWAYS">
                        <ListView fx:id="listServis" HBox.hgrow="ALWAYS"/>
                        <VBox alignment="TOP_CENTER" spacing="20" prefWidth="380" styleClass="dashboard-box">
                            <Label text="Biaya Servis Resmi" styleClass="text-accent" style="-fx-font-size: 18px;"/>
                            <Label text="Rp 2.500.000" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Button text="Bayar &amp; Servis" styleClass="btn-primary" prefWidth="300" prefHeight="50" onAction="#prosesServis"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- PAGE 4: PAJAK (MENU BARU DOSEN KILLER) -->
                <VBox fx:id="pagePajak" spacing="25.0" visible="false" opacity="0">
                    <Label text="Kalkulasi Pajak &amp; Asuransi" styleClass="text-title"/>
                    <Label text="Menggunakan ITaxable Interface untuk kalkulasi PPN/Pajak 11% tiap kendaraan." styleClass="text-subtitle"/>
                    <HBox spacing="30" VBox.vgrow="ALWAYS">
                        <ListView fx:id="listPajak" HBox.hgrow="ALWAYS" style="-fx-font-family: 'Consolas';"/>
                        <VBox alignment="TOP_CENTER" spacing="20" prefWidth="380" styleClass="dashboard-box">
                            <Label text="Total Beban Pajak" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 18px;"/>
                            <Label fx:id="lblTotalPajak" text="Rp 0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Estimasi pajak yang harus dibayarkan ke negara berdasarkan aset garasi." style="-fx-text-fill: #94a3b8; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- PAGE 5: TRADE IN -->
                <VBox fx:id="pageTradeIn" spacing="25.0" visible="false" opacity="0">
                    <Label text="Trade-In (Jual Kembali)" styleClass="text-title"/>
                    <Label text="Depresiasi 30%. Uang penjualan dikembalikan langsung ke Saldo." styleClass="text-subtitle"/>
                    <HBox spacing="30" VBox.vgrow="ALWAYS">
                        <ListView fx:id="listTradeIn" HBox.hgrow="ALWAYS"/>
                        <VBox alignment="TOP_CENTER" spacing="20" prefWidth="380" styleClass="dashboard-box">
                            <Label text="Estimasi Nilai Jual" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 18px;"/>
                            <Label fx:id="lblHargaJual" text="Rp 0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Button text="Jual Kendaraan" styleClass="btn-danger" prefWidth="300" prefHeight="50" onAction="#prosesTradeIn"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- PAGE 6: RIWAYAT -->
                <VBox fx:id="pageRiwayat" spacing="25.0" visible="false" opacity="0">
                    <Label text="Log Riwayat Transaksi" styleClass="text-title"/>
                    <ListView fx:id="listRiwayat" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Consolas';"/>
                </VBox>

                <!-- PAGE 7: VIP LOUNGE (BUG FIXED) -->
                <VBox fx:id="pageRewards" spacing="25.0" visible="false" opacity="0" alignment="CENTER">
                    <VBox maxWidth="550" styleClass="dashboard-box" alignment="CENTER" spacing="30">
                        <Label text="🎁 VIP Privilege Lounge" styleClass="text-title" style="-fx-font-size: 35px;"/>
                        <Label text="Klaim bonus harian eksklusif berdasarkan Tier OOP Anda. (Hanya 1x Sehari)" styleClass="text-subtitle"/>
                        <Label fx:id="lblTierReward" text="Status: Belum Diklaim" styleClass="text-gold" style="-fx-font-size: 20px;"/>
                        <Button fx:id="btnKlaimReward" text="KLAIM BONUS SEKARANG" styleClass="btn-primary" prefWidth="400" prefHeight="60" style="-fx-font-size: 18px;" onAction="#klaimReward"/>
                    </VBox>
                </VBox>

            </StackPane>
        </center>
    </BorderPane>

    <!-- LAYER LOGIN -->
    <StackPane fx:id="loginOverlay" styleClass="login-bg">
        <VBox maxWidth="480.0" styleClass="login-box" spacing="20.0" alignment="CENTER">
            <Label text="EEPIS MOTORS" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <VBox spacing="10">
                <Label text="NAMA IDENTITAS (KTP):" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtNama" promptText="Masukkan Nama Lengkap Anda"/>
            </VBox>
            <VBox spacing="10">
                <Label text="PROOF OF FUNDS (SALDO):" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtSaldo" promptText="Contoh: 3000000000"/>
            </VBox>
            <Button text="AUTENTIKASI &amp; MASUK" styleClass="btn-primary" onAction="#handleVerifikasi" prefWidth="480" prefHeight="50">
                <VBox.margin><Insets top="25"/></VBox.margin>
            </Button>
        </VBox>
    </StackPane>

    <!-- LAYER ANIMASI MOBIL -->
    <StackPane fx:id="animasiDriveOverlay" visible="false" styleClass="overlay-blur" mouseTransparent="true">
        <Label fx:id="lblAnimasiMobil" text="🏎️💨" style="-fx-font-size: 150px; -fx-effect: dropshadow(three-pass-box, #38bdf8, 50, 0.5, 0, 0);"/>
    </StackPane>

    <!-- LAYER MODAL & FAKTUR -->
    <StackPane fx:id="modalOverlay" visible="false" styleClass="overlay-blur">
        <VBox fx:id="modalBox" maxWidth="450" styleClass="modal-box" spacing="25" alignment="CENTER">
            <Label fx:id="lblModalTitle" text="Processing..." styleClass="text-title"/>
            <ProgressBar fx:id="progressBar" prefWidth="350" progress="0.0" style="-fx-accent: #38bdf8;"/>
            <Label fx:id="lblModalDesc" text="Mohon tunggu..." styleClass="text-subtitle" style="-fx-font-size: 16px;"/>
            <Button fx:id="btnCloseTestDrive" text="TUTUP" styleClass="btn-secondary" visible="false" onAction="#closeModal"/>
        </VBox>
        <VBox fx:id="receiptBox" maxWidth="500" maxHeight="550" styleClass="modal-box" spacing="20" alignment="CENTER" visible="false">
            <Label text="FAKTUR TRANSAKSI" styleClass="text-accent" style="-fx-font-size: 20px;"/>
            <TextArea fx:id="txtReceiptContent" style="-fx-font-family: 'Consolas'; -fx-control-inner-background: #0b0f19; -fx-text-fill: #38bdf8;" VBox.vgrow="ALWAYS" editable="false" wrapText="true"/>
            <Button text="TUTUP &amp; SIMPAN" styleClass="btn-primary" prefWidth="250" prefHeight="45" onAction="#closeModal"/>
        </VBox>
    </StackPane>

    <!-- TOAST ALARM -->
    <HBox fx:id="toastPane" translateY="-100" alignment="CENTER" maxWidth="450" maxHeight="60" styleClass="toast" StackPane.alignment="TOP_CENTER">
        <StackPane.margin><Insets top="30"/></StackPane.margin>
        <Label fx:id="lblToast" text="Notifikasi" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;"/>
    </HBox>
</StackPane>